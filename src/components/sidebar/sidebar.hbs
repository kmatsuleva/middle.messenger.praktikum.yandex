<div class="sidebar">
  <div class="sidebar__top">
    <a class="sidebar__profile" href="/profile">
      {{ profileName }}
      <img src="/images/icons/arrow.svg" alt="" width="6" height="9" />
    </a>

    <form class="sidebar__search">
      <img src="/images/icons/search.svg" alt="" width="13" height="13" />
      <input class="sidebar__search-field" type="text" name="search" placeholder="Поиск" />
    </form>
  </div>

  <ul class="sidebar__list">
    {{#each chats}}
      {{> chat-item}}
    {{/each}}
  </ul>
</div>
