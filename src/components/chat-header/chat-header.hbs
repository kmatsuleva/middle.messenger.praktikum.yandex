<header class="chat-header">
  <div class="chat-header__user">
    {{> avatar
      size="sm"
    }}
    <span class="chat-header__name">{{ name }}</span>
  </div>

  <button class="chat-header__options" type="button">
    <img src="/images/icons/options.svg" alt="" width="3" height="15" />
  </button>
</header>
