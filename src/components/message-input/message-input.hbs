<form class="message-input">
  <button class="message-input__attach" type="button">
    <img src="/images/icons/attach.svg" alt="" width="32" height="32" />
  </button>

  <input
    class="message-input__field"
    type="text"
    name="message"
    placeholder="Сообщение"
  />

  <button class="message-input__send" type="submit">
    <img src="/images/icons/back.svg" alt="" width="6" height="11" />
  </button>

</form>
