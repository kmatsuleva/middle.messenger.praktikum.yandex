{{#> profile-layout backUrl="/profile"}}
  <section class="profile">
    {{> avatar
      size="lg"
    }}

    <form class="profile__form" action="#" method="post">
      <dl class="profile__fields">
        {{> profile-field
          editable=true
          label="Почта"
          name="email"
          type="email"
          value="pochta@yandex.ru"
        }}
        {{> profile-field
          editable=true
          label="Логин"
          name="login"
          value="ivanivanov"
        }}
        {{> profile-field
          editable=true
          label="Имя"
          name="first_name"
          value="Иван"
        }}
        {{> profile-field
          editable=true
          label="Фамилия"
          name="second_name"
          value="Иванов"
        }}
        {{> profile-field
          editable=true
          label="Имя в чате"
          name="display_name"
          value="Иван"
        }}
        {{> profile-field
          editable=true
          label="Телефон"
          name="phone"
          type="tel"
          value="+7 (909) 967 30 30"
        }}
      </dl>

      {{> button
        class="profile__submit"
        type="submit"
        text="Сохранить"
      }}
    </form>
  </section>
{{/profile-layout}}
