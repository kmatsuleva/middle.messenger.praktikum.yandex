{{#> profile-layout backUrl="/profile"}}
  <section class="profile">
    {{> avatar
      size="lg"
    }}

    <form class="profile__form" action="#" method="post">
      <dl class="profile__fields">
        {{> profile-field
          editable=true
          label="Старый пароль"
          name="old_password"
          type="password"
          value="123456789"
        }}
        {{> profile-field
          editable=true
          label="Новый пароль"
          name="new_password"
          type="password"
          value="12345678901"
        }}
        {{> profile-field
          editable=true
          label="Повторите новый пароль"
          name="repeat_password"
          type="password"
          value="12345678901"
        }}
      </dl>

      {{> button
        class="profile__submit"
        type="submit"
        text="Сохранить"
      }}
    </form>
  </section>
{{/profile-layout}}
